        <div>
            <label>Kannada Marks:</label>

            <input type="text" id="kannadaValue" name="kannada" value="50">

            <input type="range"
                min="0"
                max="100"
                value="50"
                oninput="kannadaValue.value = this.value">
        </div>

        <br>
   -----------------------------------------------------------------------------

            <div>
            <label for="science">science Marks:</label>
            <input type="range"
                id="science"
                name="science"
                min="0"
                max="100"
                value="50"
                oninput="science.value = this.value">

            <output>50</output>
            </div>
            <br>
-------------------------------------------------------------------------------------
            
            <div>
            <label for="maths">Maths Marks:</label>
            <input type="range"
                id="maths"
                name="maths"
                min="0"
                max="100"
                value="50"
                oninput="maths.value = this.value">

            <output>50</output>
            </div>
            <br>
---------------------------------------------------------------------------------
            <button type="submit" class="button">Average</button>
            </form>
        </div>
    </body>
    <h3>The average marks obtained {{average_marks}}</h3>
